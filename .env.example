# Copy to .env and fill locally. Never commit .env or key material.

NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
OUTLAYER_API=https://testnet-api.outlayer.ai

SEALQUERY_API_URL=http://127.0.0.1:8000
SEALQUERY_API_KEY=
SEALQUERY_RATE_LIMIT_PER_MINUTE=5
SEALQUERY_IDEMPOTENCY_TTL_SECONDS=86400
SEALQUERY_STATE_TTL_SECONDS=5
NEAR_RPC_CONCURRENCY=3
NEARDATA_API=https://testnet.neardata.xyz
# Optional FastNEAR API key for higher Neardata limits
# NEARDATA_API_KEY=
# Optional: backfill NEP-297 events from this block height (fresh checkpoint)
# EVENT_START_BLOCK=277000000
EVENT_BLOCKS_PER_SYNC=10
EVENT_INDEXER_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=120
# JSON access key file for hosts without a NEAR keychain; required by compose.yaml
NEAR_ACCESS_KEY_FILE=

# FastAPI / Compose
DATABASE_URL=sqlite:///./backend/data/sealquery.db
REDIS_URL=
INDEXER_INTERVAL_SECONDS=15
POSTGRES_USER=sealquery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sealquery
CADDY_PORT=8080

DEPLOYER_ACCOUNT=
CONTRACT_ACCOUNT=
OWNER_ACCOUNT=
AGENT_ACCOUNT=

OUTLAYER_PROJECT_NAME=sealquery-approved
OUTLAYER_PROJECT_ID=
OUTLAYER_PAYMENT_KEY_NONCE=

DATA_HASH=
WASM_HASH=
SECRET_ACCOUNT=

DATASET_ID=retail_v1
DATASET_VERSION=retail_v1
BUDGET_PER_DAY=20
COMPUTATION_ID=spend_growth_v1

PRICE_YOCTO=20000000000000000000000
COMPUTE_DEPOSIT_YOCTO=10000000000000000000000
REWARD_YOCTO=10000000000000000000000

PROTOCOL_FEE_BPS=0
